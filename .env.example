# ──────────────────────────────────────────────
# Anniversary Website — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control
# ──────────────────────────────────────────────

# App metadata
NEXT_PUBLIC_APP_NAME="Anniversary"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Feature flags
NEXT_PUBLIC_ENABLE_AUDIO=true
NEXT_PUBLIC_ENABLE_ANIMATIONS=true

# Analytics (optional — add your provider keys here)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Deployment
# NODE_ENV is set automatically by Next.js (development | production | test)
